@model UsefulWebsites.ViewModels.WebsiteFormViewModel

<div asp-validation-summary="ModelOnly" class="admin-validation-summary"></div>

<div class="admin-form-grid">
    <div class="admin-form-group admin-form-group-full">
        <label asp-for="Name"></label>
        <input asp-for="Name" maxlength="150" placeholder="e.g. Perplexity AI" />
        <span asp-validation-for="Name"></span>
    </div>

    <div class="admin-form-group admin-form-group-full">
        <label asp-for="Url"></label>
        <input asp-for="Url" type="url" maxlength="2048" placeholder="https://example.com" />
        <span asp-validation-for="Url"></span>
    </div>

    <div class="admin-form-group admin-form-group-full">
        <label asp-for="LogoUrl"></label>
        <input asp-for="LogoUrl" type="url" maxlength="2048" placeholder="https://example.com/logo.png" />
        <span asp-validation-for="LogoUrl"></span>
        <small>If left blank, the website's initials will be displayed on the card.</small>
    </div>

    <div class="admin-form-group">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions">
            <option value="">Select a category</option>
        </select>
        <span asp-validation-for="CategoryId"></span>
    </div>

    <div class="admin-form-group">
        <label asp-for="NewCategoryName"></label>
        <input asp-for="NewCategoryName" maxlength="80" placeholder="e.g. AI Tools" />
        <span asp-validation-for="NewCategoryName"></span>
        <small>Entering a new category name takes priority over the selected category.</small>
    </div>

    <div class="admin-form-group admin-form-group-full">
        <label asp-for="Description"></label>
        <textarea asp-for="Description"
                  rows="10"
                  maxlength="6000"
                  placeholder="Describe what the website does, who it is useful for, and any key notes."></textarea>
        <div class="admin-textarea-footer">
            <span asp-validation-for="Description"></span>
            <small>Up to 6000 characters</small>
        </div>
    </div>
</div>
