@{
    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Discover and organize useful websites by category." />
    <title>@ViewData["Title"] - Useful Websites</title>

    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <a class="brand"
           asp-controller="Home"
           asp-action="Index"
           aria-label="Useful Websites home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                    <path d="M24 4 42 14v20L24 44 6 34V14L24 4Z" stroke="currentColor" stroke-width="3" />
                    <path d="M6 14 24 24 42 14M24 24v20" stroke="currentColor" stroke-width="3" />
                </svg>
            </span>

            <span class="brand-text">
                Useful
                <span>Websites</span>
            </span>
        </a>

        <nav class="top-navigation" aria-label="Main navigation">
            <a class="top-navigation-link @(currentController == "Home" ? "is-active" : string.Empty)"
               asp-controller="Home"
               asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 11.5 12 4l9 7.5V21h-6v-6H9v6H3v-9.5Z"
                          stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                </svg>
                <span>Home</span>
            </a>

            <a class="top-navigation-link @(currentController == "Admin" ? "is-active" : string.Empty)"
               asp-controller="Admin"
               asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 4 7v5c0 5 3.4 8 8 9 4.6-1 8-4 8-9V7l-8-4Z"
                          stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                    <path d="M9 12h6M12 9v6"
                          stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <span>Management</span>
            </a>
        </nav>

        <button class="theme-toggle"
                id="themeToggle"
                type="button"
                aria-label="Toggle theme"
                title="Switch between light and dark theme">
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"
                      stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
        </button>
    </header>

    <main class="page-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
